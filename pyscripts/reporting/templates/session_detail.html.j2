{% extends "_base.html.j2" %}
{% set depth = 1 %}
{% block title %}Session {{ session.session_id }}{% endblock %}
{% block content %}
<h1>Session {{ session.session_id }}</h1>
<dl class="meta">
  <dt>Address</dt><dd>{{ session.addr }}</dd>
  <dt>UA family</dt><dd>{{ session.ua_family }}</dd>
  <dt>Class</dt><dd class="cls-{{ session.bot_class }}">{{ session.bot_class }}</dd>
  <dt>Start</dt><dd>{{ session.start | fmt_dt }}</dd>
  <dt>End</dt><dd>{{ session.end | fmt_dt }}</dd>
  <dt>Requests</dt><dd>{{ session.n_req }}</dd>
  <dt>Route diversity</dt><dd>{{ session.route_diversity }}</dd>
</dl>

<h2>Signals</h2>
<ul class="signals">
{% for s in signals %}<li>{{ s }}</li>{% endfor %}
</ul>

<h2>Request timeline</h2>
{{ events_table | safe }}

<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("table.dt").forEach(t => new DataTable(t, {pageLength: 50, order: []}));
});
</script>
{% endblock %}
