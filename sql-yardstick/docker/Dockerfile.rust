FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgcc-s1 \
        socat \
    && rm -rf /var/lib/apt/lists/*

COPY target/release/rankless-server /app/rankless-server

ENV OA_ROOT=/data/oa-root

# Create a small helper script to run both
# Start the forwarder in the background
# It listens on 0.0.0.0:3000 and sends to 127.0.0.1:3038
RUN echo '#!/bin/bash\n\
socat TCP-LISTEN:3000,fork,reuseaddr TCP:127.0.0.1:3038 &\n\
\n\
exec /app/rankless-server "$@"' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/data/oa-root"]
