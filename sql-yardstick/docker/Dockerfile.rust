FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

# Binary is copied from the pre-built release artifact.
# Build from project root: docker build -f sql-yardstick/docker/Dockerfile.rust .
COPY target/release/rankless-server /app/rankless-server

# OA data directory mounted at runtime: -v /path/to/oa-root:/data/oa-root
ENV OA_ROOT=/data/oa-root

ENTRYPOINT ["/app/rankless-server"]
CMD ["/data/oa-root"]
