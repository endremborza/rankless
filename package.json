{
	"name": "rankless",
	"version": "2.7.0",
	"private": true,
	"scripts": {
		"dev": "bun --bun run vite dev --host",
		"ngrok": "ngrok http --domain=stork-settled-spider.ngrok-free.app 5173",
		"data-ngrok": "ngrok http --domain=stork-settled-spider.ngrok-free.app 8000",
		"build": "bun --bun run vite build",
		"preview": "bun --bun run vite preview",
		"deploy": "echo www.rankless.org > build/CNAME && touch build/.nojekyll && gh-pages -d build -t true -b rankless-page -o rankless",
		"alpha": "vite build && touch build/.nojekyll && gh-pages -d build -t true",
		"test": "playwright test",
		"test:unit": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/unidecode": "^0.1.3",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-xml-parser": "^5.3.4",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.56.0",
		"svelte-check": "^4.4.8",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.60.0",
		"vite": "^7.3.3",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"overrides": {
		"vite": "^7.3.3"
	},
	"dependencies": {
		"cytoscape": "^3.33.1",
		"cytoscape-fcose": "^2.2.0"
	}
}
