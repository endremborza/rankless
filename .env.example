# Template for .env. Copy to `.env` (bootstrap does this for you) and edit.
# Designer/dev defaults below assume the one-command flow in docs/dev-setup.md.
# Add private credentials only when you actually need deploy / ledger / ORCID flows.

RANKLESS_ENV=nano

# Paths to the OpenAlex snapshot bootstrap downloads, and the binary OA_ROOT
# the local pipeline produces from it. Relative paths resolve against the
# repo root. Names follow the {env}-snapshot / {env}-root convention used by
# pyscripts/make_test_dataset.py.
OA_SNAPSHOT=./data/nano-snapshot
OA_ROOT=./data/nano-root
OA_TEST_ROOT=./data/oa-test

# Where bootstrap fetches the nano *snapshot* (filtered raw JSON) from.
# Override to point at a different host once we have a canonical CDN. The
# default assumes someone is running `python -m http.server 8000` in the dir
# holding `nano-snapshot.tar.zst`.
NANO_ARTIFACT_URL=http://127.0.0.1:8000/nano-snapshot.tar.zst
# Optional SHA-256 of the artifact; bootstrap verifies if set.
NANO_ARTIFACT_SHA256=

# SvelteKit reads these at build/runtime. PUBLIC_BACKEND_URL is the address
# the SPA hits in deployed envs; locally the FE talks directly to 3038.
PUBLIC_ORIGIN=http://127.0.0.1:5173
PUBLIC_BACKEND_URL=http://127.0.0.1:3038

# Memory ceiling (GiB) the pipeline warns at. Lower it on smaller machines.
WARN_AT_RAM=7

# Required by SvelteKit's `$env/static/private` even for the dev flow; leave
# blank unless you're exercising the ORCID login.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Optional. Defaults to data/rankless.sqlite when unset.
# RANKLESS_DB_PATH=

# ── Production / deploy / ledger — not needed for local dev ──────────────────
# AWS_PROFILE=
# FILE_CHANNEL_TOKEN=
# FILE_CHANNEL_ADDR=
# PG_CONSTR=
# GMAIL_ADDR=
# GMAIL_APP_PW=
