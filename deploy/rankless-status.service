[Unit]
# Producer for nginx's :5566 /status (what live_monitoring.py polls): free memory,
# backend open files and root-FS fill, rewritten to /tmp/status_cache.json every
# few seconds.
Description=Rankless box status dump

[Service]
ExecStart={{ repo_root }}/status_dump.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
