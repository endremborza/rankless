[Unit]
Description=Rankless Frontend {{ suffix }} %i
After=network.target

[Service]
WorkingDirectory={{ repo_root }}
Environment=ORIGIN=https://{{ domain }} PORT=%i
ExecStart={{ bun }} run {{ build_dir }}/
MemoryAccounting=yes
MemoryMax={{ memory_max }}
OOMPolicy=kill
RuntimeMaxSec={{ runtime_max }}
RuntimeRandomizedExtraSec={{ runtime_jitter }}
TimeoutStopSec=5
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
